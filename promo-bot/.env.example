# Copie este arquivo para ".env" e preencha. NUNCA compartilhe o .env.

# ===== GRUPO DO WHATSAPP =====
# Rode "npm run grupos" para descobrir o ID (termina com @g.us).
# Pode colocar mais de um, separados por vírgula.
GRUPOS=

# ===== AGENDA =====
# A cada quantos minutos posta uma oferta
INTERVALO_MINUTOS=30
# Horário em que o robô posta (24h). Fora disso ele fica quieto.
HORA_INICIO=8
HORA_FIM=22
# Desconto mínimo (%) para a oferta ser postada
DESCONTO_MINIMO=20
# Palavras que o robô pesquisa (separadas por vírgula)
PALAVRAS_CHAVE=fone bluetooth,air fryer,smartwatch,tênis,perfume,panela,carregador,maquiagem,brinquedo,mochila
# Lojas ativas, na ordem do rodízio (shopee, mercadolivre, amazon)
LOJAS=shopee,mercadolivre,amazon

# ===== SHOPEE AFILIADOS =====
# affiliate.shopee.com.br > Open API > pedir acesso. Vem um App ID e uma Secret.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ===== MERCADO LIVRE =====
# 1) Crie um app em developers.mercadolivre.com.br (dá o Client ID e Secret)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# 2) Token de renovação (veja o GUIA.md, passo do Mercado Livre)
ML_REDIRECT_URI=https://www.google.com
ML_REFRESH_TOKEN=
# 3) Parâmetros do seu link de afiliado. Gere um link no painel de afiliados do
#    Mercado Livre, copie o que vem depois do "?" (ex.: matt_word=seunome&matt_tool=12345678)
ML_AFILIADO_PARAMS=

# ===== AMAZON =====
# Sua tag de associado (ex.: seunome-20). Fica em associados.amazon.com.br
AMAZON_TAG=
# Ofertas da Amazon vêm do arquivo ofertas-amazon.txt (veja o GUIA.md)
